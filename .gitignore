# Python
__pycache__/
*.py[cod]
*.egg-info/

# Editors
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Local logs / scratch
*.log
*.tmp
scratch/

# Playwright MCP per-run artifacts (snapshots / console logs)
.playwright-mcp/

# Test-generated fake worker home (steer-hook runner harness)
skills/ilk-loop/tests/fixtures/fake_worker/

# Per-machine config that should not leave the developer's box —
# personal project paths, secrets, IDE-generated rules, etc. Each
# operator copies the *.example.json next to it and edits in place.
skills/ilk-launcher/projects.json
.cursor/
**/.ilk-launcher/
.ilk-data/
.ilk-watchdog/
skills/ilk-loop/logs/

# Per-checkout runtime artifact written by the loop runner
# (run_ilk_loop_claude.{sh,ps1}) — records this clone's remote-type
# (personal|shared) for commit-trailer policy. Must never be committed.
.ilk-remote-type

# Per-checkout ilk-lark-tickets marker — names which Lark tracker this
# clone talks to. Not a credential, but it should not travel with a
# public/shared repo. See skills/ilk-lark-tickets/README.md § Security.
.lark-project

# Release baselines written by skills/ilk-ship (baseline_diff.store_baseline).
# NOT committed, for two reasons:
#  1. A baseline is host-specific — the same tag measured 746 passed/15 skipped
#     on chad-mbp and 745/16 on rezmac at v0.9.66 — so it is not shared state.
#  2. Committing it poisoned the next release's gate decision: `.json` is a
#     path/schema extension, so last release's artifact forced the next release
#     to tier 3 regardless of what changed (measured 2026-08-19).
.ilk-baselines/
