#!/usr/bin/env bash
# stub-claude — a minimal agent that simulates a worker for the golden batch.
#
# Reads ILK_ITERATION_SUBPLAN, finds the sub-plan, applies the step patch,
# commits with the plan trailer, advances current_step, and ships after the
# last step.  Prints stream-json lines the runner's renderer accepts.

set -euo pipefail

slug="${ILK_ITERATION_SUBPLAN:?ILK_ITERATION_SUBPLAN not set}"
skill_home="${ILK_SKILL_HOME:?ILK_SKILL_HOME not set}"
data_home="${ILK_DATA_HOME:?ILK_DATA_HOME not set}"

# Resolve the plans directory.
project_key=$(python3 -c "
import sys; sys.path.insert(0, '${skill_home}/ilk-loop/scripts')
from ilk_paths import project_key
from pathlib import Path
print(project_key(Path('.').resolve()))
")
plans_dir="${data_home}/projects/${project_key}/plans"
plan_file="${plans_dir}/2026-10-04-${slug}.md"

# Read current_step from front-matter.
current_step=$(python3 -c "
import re, sys
from pathlib import Path
text = Path(sys.argv[1]).read_text()
m = re.search(r'^current_step:\s*(\d+)', text, re.MULTILINE)
print(m.group(1) if m else '0')
" "$plan_file")

# Read estimated_steps from front-matter.
estimated_steps=$(python3 -c "
import re, sys
from pathlib import Path
text = Path(sys.argv[1]).read_text()
m = re.search(r'^estimated_steps:\s*(\d+)', text, re.MULTILINE)
print(m.group(1) if m else '1')
" "$plan_file")

# Write the transformation script to a temp file to avoid bash quoting issues.
transform_script=$(mktemp /tmp/stub_transform_XXXXXX.py)
cat > "$transform_script" << 'PYEOF'
import sys
import re
from pathlib import Path

slug = sys.argv[1]
step = int(sys.argv[2])

if slug == 'golden-real':
    if step == 0:
        # Add xfail mark to test_scale in test_scale.py
        p = Path('tests/test_scale.py')
        text = p.read_text()
        text = text.replace('from calc import scale', 'import pytest\nfrom calc import scale')
        text = text.replace('def test_scale():', '@pytest.mark.xfail(strict=True, reason="scale is broken: multiplies instead of dividing")\ndef test_scale():')
        p.write_text(text)
    elif step == 1:
        # Fix scale and remove xfail
        p = Path('calc.py')
        text = p.read_text()
        text = text.replace('return value * factor', 'return value / factor')
        p.write_text(text)
        p = Path('tests/test_scale.py')
        text = p.read_text()
        # Remove import pytest line
        text = re.sub(r'import pytest\n', '', text)
        # Remove xfail decorator line
        text = re.sub(r'@pytest\.mark\.xfail\(.*?\)\n', '', text)
        # Update docstring to remove BUG note
        text = text.replace('Pin: scale(10, 2) should be 5.0 (10 / 2).  BUG: returns 20.0.', 'scale(10, 2) should be 5.0 (10 / 2).')
        p.write_text(text)

elif slug == 'golden-inert':
    if step == 0:
        # Add vacuous pin as a NEW test in test_other.py (not test_scale)
        p = Path('tests/test_other.py')
        text = p.read_text()
        # Add import pytest if not already present
        if 'import pytest' not in text:
            text = 'import pytest\n' + text
        # Append vacuous test function
        text += '\n\n@pytest.mark.xfail(strict=True, reason="vacuous pin: hand-writes the expected value")\n'
        text += 'def test_vacuous():\n'
        text += '    """Vacuous pin: asserts True — the decay (a) shape."""\n'
        text += '    assert True\n'
        p.write_text(text)

elif slug == 'golden-red':
    if step == 0:
        # Break add AND pin it with xfail
        p = Path('calc.py')
        text = p.read_text()
        text = text.replace('return a + b', 'return a - b')
        p.write_text(text)
        p = Path('tests/test_calc.py')
        text = p.read_text()
        # Add import pytest if not already present
        if 'import pytest' not in text:
            text = text.replace('from calc import add, scale, clamp', 'import pytest\nfrom calc import add, scale, clamp')
        text = text.replace('def test_add():', '@pytest.mark.xfail(strict=True, reason="add is broken")\ndef test_add():')
        p.write_text(text)
    elif step == 1:
        # Fix add, break clamp, remove xfail
        p = Path('calc.py')
        text = p.read_text()
        text = text.replace('return a - b', 'return a + b')
        text = text.replace('return max(lo, min(hi, value))', 'return min(lo, max(hi, value))')
        p.write_text(text)
        p = Path('tests/test_calc.py')
        text = p.read_text()
        # Remove import pytest line
        text = re.sub(r'import pytest\n', '', text)
        # Remove xfail decorator line
        text = re.sub(r'@pytest\.mark\.xfail\(.*?\)\n', '', text)
        p.write_text(text)
PYEOF

# Apply the patch file if it exists, otherwise use the hard-coded transformation.
patch_file="script/${slug}/step-${current_step}.patch"
if [[ -f "$patch_file" ]]; then
    # Apply the unified diff patch.
    git apply "$patch_file"
else
    python3 "$transform_script" "$slug" "$current_step"
fi
rm -f "$transform_script"

# Stage and commit.
git add -A
git -c user.email=t@example.com -c user.name=t \
    commit -q -m "feat: step ${current_step} [plan:${slug}#step-${current_step}]" \
    --allow-empty

# Advance current_step.
python3 -c "
import re, sys
from pathlib import Path
p = Path(sys.argv[1])
text = p.read_text()
old = int(sys.argv[2])
text = re.sub(
    r'^current_step:\s*\d+',
    f'current_step: {old + 1}',
    text, count=1, flags=re.MULTILINE
)
p.write_text(text)
" "$plan_file" "$current_step"

# Ship after the last step.
next_step=$((current_step + 1))
if [[ "$next_step" -ge "$estimated_steps" ]]; then
    python3 "${skill_home}/ilk-loop/scripts/ship_transition.py" \
        --ship "$slug" --plans-dir "$plans_dir" --repo "$(pwd)" 2>&1 || true
fi

# Print stream-json lines the renderer accepts.
session_id="stub-$$"
cat <<EOF
{"type":"system","subtype":"init","model":"stub","session_id":"${session_id}","cwd":"$(pwd)"}
{"type":"assistant","message":{"role":"assistant","content":[{"type":"text","text":"step ${current_step} done"}]}}
{"type":"result","subtype":"success","duration_ms":100,"total_cost_usd":0.0,"usage":{"input_tokens":0,"output_tokens":0}}
EOF
